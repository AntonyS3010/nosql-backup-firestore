{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 19098
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 18081,
      "websocketPort": 9151
    },
    "hosting": {
      "host": "127.0.0.1",
      "port": 15001
    },
    "ui": {
      "enabled": false
    },
    "hub": {
      "host": "127.0.0.1",
      "port": 14401
    },
    "logging": {
      "host": "127.0.0.1",
      "port": 14501
    },
    "singleProjectMode": true
  }
}
