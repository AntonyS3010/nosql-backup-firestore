rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/tasks/{taskId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validTask() {
        let data = request.resource.data;
        return data.keys().hasAll(['title', 'completed', 'createdAt'])
          && data.keys().hasOnly(['title', 'completed', 'createdAt'])
          && data.title is string && data.title.size() > 0 && data.title.size() <= 100
          && data.title.matches('.*[^\\s].*')
          && data.completed is bool && data.createdAt is timestamp;
      }
      allow read, delete: if owner();
      allow create: if owner() && validTask()
        && request.resource.data.createdAt == request.time
        && request.resource.data.completed == false;
      allow update: if owner() && validTask()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed']);
    }
  }
}
